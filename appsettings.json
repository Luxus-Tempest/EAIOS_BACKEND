{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eaios;Username=eaios;Password=eaios_dev;Include Error Detail=true"
  },
  "Security": {
    "TokenSigningKey": "eaios-dev-signing-key-CHANGE-IN-PRODUCTION-must-be-at-least-64-characters-long!",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "MfaSessionLifetimeMinutes": 5,
    "PasswordResetTokenLifetimeHours": 1,
    "EmailVerificationTokenLifetimeHours": 24,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "ApiKeyPrefix": "eak"
  },
  "Storage": {
    "Provider": "Local",
    "LocalBasePath": "uploads",
    "BaseUrl": "http://localhost:5118/uploads",
    "MaxFileSizeBytes": 10485760,
    "MaxMultipartFileSizeBytes": 5368709120,
    "ChunkSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".pptx", ".odt", ".ods", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".tiff", ".mp4", ".avi", ".mov", ".mp3", ".wav", ".json", ".xml", ".csv", ".yaml", ".yml", ".txt", ".md", ".zip", ".tar", ".7z" ]
  },
  "Ai": {
    "Provider": "Stub",
    "EmbeddingDimensions": 3072,
    "DefaultModel": "gpt-4o",
    "DefaultEmbeddingModel": "text-embedding-3-large"
  },
  "RateLimit": {
    "Auth": { "WindowSeconds": 60, "PermitLimit": 10 },
    "ForgotPassword": { "WindowSeconds": 3600, "PermitLimit": 5 },
    "Global": { "WindowSeconds": 60, "PermitLimit": 1000 }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  }
}
